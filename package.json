{
  "name": "supernote-bridge",
  "version": "0.0.1",
  "private": true,
  "description": "Sync Supernote notebooks into Obsidian",
  "main": "main.js",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run build && npm run test",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "^1.14.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
